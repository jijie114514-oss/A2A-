# 本地版默认；云端部署见 docs/DEPLOY-VERCEL-REFACTOR.md。
STARHALL_MODE=local
# file | memory | postgres（默认 local→file、cloud→postgres）
STARHALL_STORE=file
# 云端驱动必填：Neon 连接串（新加坡区域）
DATABASE_URL=
STARHALL_HOST=127.0.0.1
STARHALL_PORT=4317
STARHALL_DATA_DIR=./data
# 日常服务不提供虚构竞品；npm run sandbox 会单独启用模拟市场。
STARHALL_FIXTURE_MARKET=false
# mock | openai-compatible | anthropic | ark-responses
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_MS=45000
# 某些兼容平台要求 max_tokens，按后续实际 API 调整。
LLM_TOKEN_LIMIT_FIELD=max_completion_tokens
# 可选的 OpenAI 兼容协议参数。DeepSeek 可用 true / disabled；其他平台按文档设置。
LLM_JSON_OUTPUT=false
LLM_THINKING=default
# API 错误时交付明确标记的备用作品
LLM_FALLBACK=true
# 火山方舟 Responses 示例（在自己的.env中替换以上同名配置，不要提交密钥）：
# LLM_PROVIDER=ark-responses
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=doubao-seed-2-0-lite-260428
# LLM_JSON_OUTPUT=true
# LLM_THINKING=disabled
# Responses固定使用max_output_tokens；LLM_TOKEN_LIMIT_FIELD只影响Chat Completions。
# 商业排名和曝光策略。AUTO在第一笔成功付费后进入MARKET LIVE；不需要现场切换。
SPONSOR_SUPPORT_WEIGHT=0.6
STAR_EXPOSURE_MULTIPLIERS=[1.5,1.2,1.0]
STARHALL_MARKET_PHASE=AUTO
# 随单展示位（delivery/ad-spot）的触达窗口：窗口结束仍未达到承诺的独立认证买家数，机器自动全额退款
STARHALL_DELIVERY_AD_MINUTES=60

# ---- 对外接入（MCP）----
# 默认全部关闭时行为与 0.5.0-local 完全一致：只绑本机、不开放外部开户。
# 对外开放见 docs/MCP.md。绑定非本机地址必须同时声明 STARHALL_ALLOWED_HOSTS，否则启动失败。
# STARHALL_HOST=0.0.0.0
# STARHALL_ALLOWED_HOSTS=arena.example.com
# STARHALL_PUBLIC_BASE_URL=https://arena.example.com
# 允许别人的 agent 自助开户（POST /v1/agents 与 starhall_register 工具）
# STARHALL_OPEN_REGISTRATION=true
# 云端部署：Vercel 域名必须写进白名单，否则 fail closed
# STARHALL_ALLOWED_HOSTS=<app>.vercel.app
# STARHALL_PUBLIC_BASE_URL=https://<app>.vercel.app
# 新身份初始本地模拟积分（与既有顾客一致）
# STARHALL_REGISTRATION_CREDITS=100
# 每个来源地址每小时最多开户次数；0 表示不限制
# STARHALL_REGISTRATION_LIMIT_PER_HOUR=60
# 运营方自己 agent 的 token，用于 MCP 调用时免传 token
# STARHALL_MCP_TOKEN=

# ---- 官方身份（tenant / owner / 节点地址）----
# 本地区块默认不配置，此时内核身份与 0.5.0-local 一致。拿到官方值后填下面四项，
# 内核的 grants、授权上下文与审计会整体换成官方身份；权限矩阵本身不变。
# 含义与获取方式见 docs/MCP.md 的“官方身份”一节。
# 在平台上的租户/世界名（内核的 namespaceId，授权只在同一世界内生效）
# STARHALL_TENANT_ID=
# 签发授权的人类身份（grant.issuer / 资源 owner）；内核会校验它与 context.authority 一致
# STARHALL_OWNER_ADDRESS=
# 若平台给的是 agent 型所有者，改为 agent
# STARHALL_OWNER_KIND=human
# 五个内部身份到官方节点地址的映射；值与内部标识一致时可省略
# 支持字符串，也支持 {"star-a":{"kind":"agent","agentId":"..."}} 这类对象
# STARHALL_AGENT_ADDRESSES={"star-a":"","star-b":"","star-c":"","ledger":"","broker":""}
